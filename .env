# ---------------------------------------------------------------------------
# Docker Compose reads this file automatically for ${VAR} substitution.
# Every pinned version and every host port lives here and nowhere else.
# ---------------------------------------------------------------------------

# ---- Image tags (all verified to exist on Docker Hub) ----
POSTGRES_TAG=16-alpine
JAEGER_TAG=1.76.0
PROMETHEUS_TAG=v3.13.2
GRAFANA_TAG=13.1.3
OTELCOL_TAG=0.158.0

# ---- OpenTelemetry Java agent (fetched by tools/fetch-agent.ps1) ----
OTEL_AGENT_VERSION=2.30.0

# ---- Database ----
POSTGRES_DB=aiops
POSTGRES_USER=aiops
# Throwaway development credential, committed on purpose so `docker compose up`
# works straight after a clone. It is safe to publish because it guards nothing:
# Postgres is reachable only on localhost and inside the compose network, the
# database holds five rows of fake stock, and the whole stack is torn down and
# recreated constantly. A real deployment would take this from a secret manager
# and this file would hold no value at all.
POSTGRES_PASSWORD=aiops

# ---- Host ports ----
# Change any of these if Windows already owns the port. 8080 and 3000 are the
# two most likely to collide.
GATEWAY_PORT=8080
ORDERS_PORT=8081
INVENTORY_PORT=8082
POSTGRES_PORT=5432
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
COLLECTOR_PROM_PORT=8889
COLLECTOR_HEALTH_PORT=13133
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
