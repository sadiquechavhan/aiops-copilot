# Java / Maven
target/
*.class

# The OpenTelemetry agent is a 25 MB binary fetched by tools/fetch-agent.ps1.
# Binaries do not belong in git; the fetch script is the reproducible artefact.
otel/agent/*.jar

# Python
__pycache__/
*.pyc
.venv/

# Per-run artefacts from tools/scenario_runner.py: traffic logs, signal tables,
# run metadata. Regenerated by any run. ground_truth.jsonl is NOT ignored -- the
# labels are the durable output of Session 2 and everything downstream is scored
# against them.
runs/

# IDE
.idea/
*.iml
.vscode/

# Claude Code per-machine settings. settings.local.json is personal by convention
# and contains absolute paths from this machine; settings.json would be shared.
.claude/settings.local.json

# Private working notes, kept on disk but out of the public repo. The build plan
# names a specific target employer, and the engineering log and progress file are
# personal interview preparation rather than project documentation. README.md is
# the public account of the same work.
BUILD_PLAN.md
ENGINEERING_LOG.md
PROGRESS.md
