{
  "uid": "aiops-overview",
  "title": "AIOps — Service Overview",
  "tags": ["aiops", "session-1", "session-2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },

  "annotations": {
    "list": [
      {
        "name": "Injected faults",
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "type": "dashboard",
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "target": { "type": "tags", "matchAny": false, "tags": ["chaos"], "limit": 100 }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "The Session 1 done condition. /health is excluded because the Compose healthcheck fires every 10s on every service and would otherwise dominate the graph. /chaos is excluded for tidiness only — it is roughly 12 requests per 30-minute run and could not distort anything. The spans and samples are still in Jaeger and Prometheus, deliberately: ground_truth.jsonl is written by the injector and is therefore a self-report, and the /chaos spans are the only independent record of when the injection actually landed.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_route!~\"/health|/chaos.*\"}[1m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by service",
      "description": "Computed from the OTel histogram buckets. The 5m window is wider than the 1m used for rate because quantiles need more samples to be stable at 6 req/s.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health|/chaos.*\"}[5m])))",
          "legendFormat": "{{service_name}} p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error rate by service",
      "description": "Flat zero is the expected baseline. Session 2's injected error-rate fault is what this panel exists to show. /chaos is excluded because the control plane emits 5xx of its own — 501 for pool-exhaust on a service with no pool, 503 when CHAOS_ENABLED=false — and those are operator responses, not application errors. Found the hard way: a single 501 probe put a permanent series on this panel. Injected 500s are NOT hidden by this filter; they carry the real route (/reserve, /orders, /api/orders), verified against Jaeger.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\", http_route!~\"/chaos.*\"}[1m]))",
          "legendFormat": "{{service_name}} 5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap used",
      "description": "Each container is capped by mem_limit with -XX:MaxRAMPercentage=70, so heap should plateau well below the limit. A sawtooth is normal GC; a rising floor is not.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum by (service_name) (jvm_memory_used_bytes{jvm_memory_type=\"heap\"})",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Hikari connection pool (inventory)",
      "description": "Pool is capped at 10 connections. This is the panel Session 2's pool-exhaustion fault will move: 'used' climbing to 10 while pending requests rise above zero.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum by (state) (db_client_connections_usage{pool_name=\"inventory-pool\"})",
          "legendFormat": "connections {{state}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum(db_client_connections_pending_requests{pool_name=\"inventory-pool\"})",
          "legendFormat": "pending requests"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Collector pipeline health (spans)",
      "description": "The pipeline's own health, not the application's. 'accepted' and 'sent' should track each other; any gap, or a non-zero 'refused', means telemetry is being lost and every number downstream is understated. Note these metrics carry no _total suffix.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum(rate(otelcol_receiver_accepted_spans[1m]))",
          "legendFormat": "accepted"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum(rate(otelcol_exporter_sent_spans[1m]))",
          "legendFormat": "sent to Jaeger"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "aiops-prometheus" },
          "expr": "sum(rate(otelcol_receiver_refused_spans[1m]))",
          "legendFormat": "refused (memory_limiter)"
        }
      ]
    }
  ]
}
